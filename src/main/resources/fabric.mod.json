{
  "schemaVersion": 1,
  "id": "zephyrium",
  "version": "${version}",
  "name": "Zephyrium",
  "description": "Ticks every server entity in its own Erlang-style process on a virtual thread, with bytecode-enforced ownership.",
  "authors": [
    "Zefir (Stikulzon)"
  ],
  "license": "ARR",
  "icon": "assets/zephyrium/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ua.zefir.zephyrium.ZephyrModInit"
    ],
    "mixinsquared": [
      "ua.zefir.zephyrium.compatibility.c2me.C2meMixinCanceller"
    ],
    "preLaunch": [
      "ua.zefir.zephyrium.ZephyrPreLaunch"
    ]
  },
  "mixins": [
    "zephyrium-process.mixins.json",
    "zephyrium-process-world.mixins.json",
    "zephyrium-process-neighbour.mixins.json",
    "zephyrium-process-push.mixins.json",
    "zephyrium-process-brain.mixins.json",
    "zephyrium-process-network.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "c2me-fabric": "*"
  },
  "accessWidener": "zephyrium.accesswidener",
  "custom": {
    "lithium:options": {
      "mixin.chunk.entity_class_groups": false,
      "mixin.entity.collisions.unpushable_cramming": false,
      "mixin.entity.inactive_navigations": false
    }
  }
}
